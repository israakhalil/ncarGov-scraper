{"Id": 11939, "EncriptedId": "rGXlqRZmuytJFMoXqt7k%2Bw%3D%3D", "NameAR": "\u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u062e\u0635\u064a\u0635 \u0644\u0639\u0627\u0645 1442\u0647\u0640", "SummeryAR": "\u062a\u0636\u0645\u0646 \u0627\u0644\u0646\u0638\u0627\u0645: \u062a\u0639\u0631\u064a\u0641\u0627\u062a\u060c \u062c\u0647\u0627\u062a \u0635\u0644\u0627\u062d\u064a\u0629 \u0625\u0635\u062f\u0627\u0631 \u0645\u0648\u0627\u0641\u0642\u0627\u062a \u0648\u062f\u0631\u0627\u0633\u0629 \u0648\u062a\u0646\u0641\u064a\u0630 \u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u062a\u062e\u0635\u064a\u0635\u060c \u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0645\u0646\u0638\u0645\u0629\u060c \u0623\u0647\u062f\u0627\u0641 \u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u062a\u062e\u0635\u064a\u0635\u060c \u0627\u0644\u0639\u0642\u0648\u062f \u0648\u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0633\u0631\u064a \u0639\u0644\u064a\u0647\u0627 \u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u0646\u0638\u0627\u0645\u060c \u0623\u0633\u0627\u0644\u064a\u0628 \u0627\u0644\u062a\u062e\u0635\u064a\u0635\u060c \u0645\u0647\u0645\u0627\u062a \u0648\u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629\u060c \u0627\u0644\u0646\u0638\u0631 \u0641\u064a \u0623\u064a \u0645\u0634\u0631\u0648\u0639 \u0645\u0631\u062a\u0628\u0637 \u0628\u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u0623\u0648 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629\u060c \u0627\u0644\u062f\u0639\u0645 \u0627\u0644\u0645\u0627\u0644\u064a \u0648\u0627\u0644\u0627\u0626\u062a\u0645\u0627\u0646\u064a \u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u062a\u062e\u0635\u064a\u0635\u060c \u062a\u0639\u0630\u0631 \u0623\u0648 \u062a\u0623\u062e\u0631 \u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u062a\u0631\u062e\u064a\u0635\u060c \u0637\u0631\u062d \u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u062a\u062e\u0635\u064a\u0635 \u0648\u0625\u0644\u063a\u0627\u0626\u0647\u060c \u0634\u0631\u0643\u0629 \u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u062a\u062e\u0635\u064a\u0635\u060c \u0625\u0628\u0631\u0627\u0645 \u0627\u0644\u0642\u0639\u0648\u062f\u060c \u0634\u0647\u0627\u062f\u0629 \u0627\u0644\u0637\u0631\u0641 \u0627\u0644\u062e\u0627\u0635\u060c \u0639\u0642\u062f \u0627\u0644\u0634\u0631\u0627\u0643\u0629\u060c \u0627\u0644\u062a\u0632\u0627\u0645\u0627\u062a \u0627\u0644\u0637\u0631\u0641 \u0627\u0644\u062e\u0627\u0635\u060c \u0627\u0644\u062a\u0646\u0627\u0632\u0644 \u0639\u0646 \u0639\u0642\u062f \u0627\u0644\u0634\u0631\u0627\u0643\u0629 \u0648\u0627\u0644\u062a\u0639\u0627\u0642\u062f \u0645\u0646 \u0627\u0644\u0628\u0627\u0637\u0646\u060c \u0627\u0644\u0631\u0642\u0627\u0628\u0629 \u0639\u0644\u0649 \u0627\u0644\u0639\u0642\u062f\u060c \u0627\u0644\u0634\u0631\u0637 \u0627\u0644\u062c\u0632\u0627\u0626\u064a \u0648\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u062e\u062f\u0645\u0627\u062a\u060c \u062d\u0627\u0644\u0627\u062a \u0625\u0646\u0647\u0627\u0621 \u0639\u0642\u062f \u0627\u0644\u0634\u0631\u0627\u0643\u0629\u060c \u0627\u0644\u0627\u062d\u062a\u0643\u0627\u0631\u060c \u0633\u062c\u0644 \u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u062a\u062e\u0635\u064a\u0635\u060c \u0627\u0644\u0645\u0646\u0627\u0641\u0633\u0627\u062a \u0648\u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a\u060c \u0641\u0636 \u0627\u0644\u0645\u0646\u0627\u0632\u0639\u0627\u062a\u060c \u0644\u063a\u0629 \u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0648\u062b\u0627\u0626\u0642\u060c \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0627\u0644\u0623\u062c\u0646\u0628\u064a\u060c \u0634\u0631\u0648\u0637 \u0627\u0633\u062a\u0626\u062c\u0627\u0631 \u0639\u0642\u0627\u0631 \u0641\u064a \u0645\u0643\u0629 \u0648\u0627\u0644\u0645\u062f\u064a\u0646\u0629\u060c \u0646\u0632\u0639 \u0645\u0644\u0643\u064a\u0629 \u0627\u0644\u0639\u0642\u0627\u0631\u0627\u062a\u060c \u0644\u062c\u0627\u0646 \u0627\u0644\u062a\u0638\u0644\u0645", "OriginalAttachPath": "https://www.ncar.gov.sa//Uploads//b4e8febc-75ee-4c47-86f2-0ff4e9729e85.pdf"},
{"Id": 11940, "EncriptedId": "h1MukvJPaSi4z%2BL8oSIAjw%3D%3D", "NameAR": "\u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u0628\u0646\u062f (\u0623\u0648\u0644\u0627\u064b) \u0645\u0646 \u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0632\u064a\u0627\u062f\u0629 \u062d\u0635\u0629 \u0627\u0644\u0642\u0637\u0627\u0639 \u0627\u0644\u0623\u0647\u0644\u064a \u0648\u062a\u0648\u0633\u064a\u0639 \u0645\u0633\u0627\u0647\u0645\u062a\u0647 \u0641\u064a \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f \u0627\u0644\u0648\u0637\u0646\u064a", "SummeryAR": "\u062a\u0636\u0645\u0646 \u0642\u0631\u0627\u0631 \u0645\u062c\u0644\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621: \u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u0628\u0646\u062f (\u0623\u0648\u0644\u0627\u064b) \u0645\u0646 \u0642\u0631\u0627\u0631 \u0645\u062c\u0644\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621 \u0631\u0642\u0645 (60) \u0648\u062a\u0627\u0631\u064a\u062e 1/4/1418\u0647\u0640\u060c \u0627\u0644\u062e\u0627\u0635 \u0628\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0632\u064a\u0627\u062f\u0629 \u062d\u0635\u0629 \u0627\u0644\u0642\u0637\u0627\u0639 \u0627\u0644\u0623\u0647\u0644\u064a \u0648\u062a\u0648\u0633\u064a\u0639 \u0645\u0633\u0627\u0647\u0645\u062a\u0647 \u0641\u064a \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f \u0627\u0644\u0648\u0637\u0646\u064a.", "OriginalAttachPath": "https://www.ncar.gov.sa//Uploads//fd48e385-354b-4ece-9550-846613180023.pdf"},
{"Id": 11941, "EncriptedId": "ay2ln17T1uzBAHYwN8FlEg%3D%3D", "NameAR": "\u0625\u0644\u063a\u0627\u0621 \u062a\u0648\u0644\u064a \u0645\u062c\u0644\u0633 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f \u0627\u0644\u0623\u0639\u0644\u0649 \u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u062a\u062e\u0635\u064a\u0635", "SummeryAR": "\u062a\u0636\u0645\u0646 \u0642\u0631\u0627\u0631 \u0645\u062c\u0644\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621: \u0625\u0644\u063a\u0627\u0621 \u0642\u0631\u0627\u0631 \u0645\u062c\u0644\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621 \u0631\u0642\u0645 (257) \u0648\u062a\u0627\u0631\u064a\u062e 11/11/1421\u0647\u0640\u060c \u0627\u0644\u062e\u0627\u0635 \u0628\u062a\u0648\u0644\u064a \u0645\u062c\u0644\u0633 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f \u0627\u0644\u0623\u0639\u0644\u0649 \u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u062a\u062e\u0635\u064a\u0635.", "OriginalAttachPath": "https://www.ncar.gov.sa//Uploads//87874e89-5be4-40af-bb0e-de5b87754553.pdf"},
{"Id": 11942, "EncriptedId": "U2rfD7irkyxkqdgZmKXlwA%3D%3D", "NameAR": "\u0625\u0644\u063a\u0627\u0621 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0631\u0627\u0641\u0642 \u0648\u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0646\u0634\u0627\u0637 \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u0629 \u0628\u0627\u0644\u062a\u062e\u0635\u064a\u0635 \u0644\u0639\u0627\u0645 1423\u0647\u0640", "SummeryAR": "\u062a\u0636\u0645\u0646 \u0642\u0631\u0627\u0631 \u0645\u062c\u0644\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621: \u0625\u0644\u063a\u0627\u0621 \u0642\u0631\u0627\u0631 \u0645\u062c\u0644\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621 \u0631\u0642\u0645 (219) \u0648\u062a\u0627\u0631\u064a\u062e 6/9/1423\u0647\u0640\u060c \u0627\u0644\u062e\u0627\u0635 \u0628\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0631\u0627\u0641\u0642 \u0648\u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0646\u0634\u0627\u0637 \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u0629 \u0628\u0627\u0644\u062a\u062e\u0635\u064a\u0635.", "OriginalAttachPath": "https://www.ncar.gov.sa//Uploads//d49ad8ee-0308-4aab-95f4-a2273b2c705d.pdf"},
{"Id": 11943, "EncriptedId": "iLXCdZaImQGCR%2Fn2ySIYaw%3D%3D", "NameAR": "\u0625\u0644\u063a\u0627\u0621 \u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0629 \u0627\u0644\u062a\u062e\u0635\u064a\u0635 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0644\u0639\u0627\u0645 1423\u0647\u0640", "SummeryAR": "\u062a\u0636\u0645\u0646 \u0642\u0631\u0627\u0631 \u0645\u062c\u0644\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621: \u0625\u0644\u063a\u0627\u0621 \u0642\u0631\u0627\u0631 \u0627\u0644\u0645\u062c\u0644\u0633 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f\u064a \u0627\u0644\u0623\u0639\u0644\u0649 (\u0627\u0644\u0645\u0644\u063a\u0649) \u0631\u0642\u0645 (1/23) \u0648\u062a\u0627\u0631\u064a\u062e 23/3/1423\u0647\u0640\u060c \u0627\u0644\u0642\u0627\u0636\u064a \u0628\u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0629 \u0627\u0644\u062a\u062e\u0635\u064a\u0635 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629.", "OriginalAttachPath": "https://www.ncar.gov.sa//Uploads//26239d9b-7654-4ca0-a16e-84ac4c2d78a1.pdf"},
{"Id": 11945, "EncriptedId": "y3RLUTluu5LfEn%2Bsz7OwQQ%3D%3D", "NameAR": "\u062c\u0648\u0627\u0632 \u0627\u0644\u0627\u062a\u0641\u0627\u0642 \u0639\u0644\u0649 \u0641\u0636 \u0627\u0644\u0645\u0646\u0627\u0632\u0639\u0627\u062a \u0627\u0644\u0646\u0627\u0634\u0626\u0629 \u0639\u0646 \u0639\u0642\u062f \u0627\u0644\u062a\u062e\u0635\u064a\u0635 \u0623\u0648 \u0623\u064a \u0639\u0642\u0648\u062f \u062a\u0627\u0628\u0639\u0629 \u0644\u0647 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u062a\u062d\u0643\u064a\u0645", "SummeryAR": "\u062a\u0636\u0645\u0646 \u0642\u0631\u0627\u0631 \u0645\u062c\u0644\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621: \u062c\u0648\u0627\u0632 \u0627\u0644\u0627\u062a\u0641\u0627\u0642 \u0639\u0644\u0649 \u0641\u0636 \u0627\u0644\u0645\u0646\u0627\u0632\u0639\u0627\u062a \u0627\u0644\u0646\u0627\u0634\u0626\u0629 \u0639\u0646 \u0639\u0642\u062f \u0627\u0644\u062a\u062e\u0635\u064a\u0635\u060c \u0623\u0648 \u0623\u064a \u0639\u0642\u0648\u062f \u062a\u0627\u0628\u0639\u0629 \u0644\u0647 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u062a\u062d\u0643\u064a\u0645 \u2013 \u0633\u0648\u0627\u0621 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0623\u0648 \u062e\u0627\u0631\u062c\u0647\u0627 \u2013 \u0648\u0641\u0642 \u0642\u0648\u0627\u0639\u062f \u064a\u0635\u062f\u0631\u0647\u0627 \u0645\u062c\u0644\u0633 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0644\u062a\u062e\u0635\u064a\u0635\u060c \u0639\u0644\u0649 \u0623\u0646 \u062a\u062a\u0636\u0645\u0646 \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0646\u0638\u0627\u0645 (\u0627\u0644\u0642\u0627\u0646\u0648\u0646) \u0648\u0627\u062c\u0628 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0633\u0648\u0627\u0621 \u0623\u062c\u0631\u064a \u0627\u0644\u062a\u062d\u0643\u064a\u0645 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0623\u0648 \u062e\u0627\u0631\u062c\u0647\u0627.", "OriginalAttachPath": "https://www.ncar.gov.sa//Uploads//e3679bc4-2142-4dbc-8d10-3372448bf1ae.pdf"},
{"Id": 11936, "EncriptedId": "HcHvlKzPqZQByMA%2BEUJ8%2Bg%3D%3D", "NameAR": "\u0639\u0642\u0648\u0628\u0627\u062a \u0645\u0646 \u064a\u0633\u0647\u0644 \u062f\u062e\u0648\u0644 \u0627\u0644\u0645\u062a\u0633\u0644\u0644 \u0644\u0644\u0645\u0645\u0644\u0643\u0629 \u0623\u0648 \u0646\u0642\u0644\u0647 \u062f\u0627\u062e\u0644\u0647\u0627 \u0623\u0648 \u064a\u0648\u0641\u0631 \u0644\u0647 \u0627\u0644\u0645\u0623\u0648\u0649 \u0623\u0648 \u064a\u0642\u062f\u0645 \u0644\u0647 \u0623\u064a \u0645\u0633\u0627\u0639\u062f\u0629 \u0623\u0648 \u062e\u062f\u0645\u0629 \u0628\u0623\u064a \u0634\u0643\u0644 \u0645\u0646 \u0627\u0644\u0623\u0634\u0643\u0627\u0644 \u0644\u0639\u0627\u0645 1442\u0647\u0640", "SummeryAR": "\u062a\u0636\u0645\u0646 \u0627\u0644\u0623\u0645\u0631 \u0627\u0644\u0645\u0644\u0643\u064a: \u062a\u062d\u062f\u064a\u062f \u0645\u062f\u0629 \u0627\u0644\u0633\u062c\u0646\u060c \u062a\u062d\u062f\u064a\u062f \u0645\u0628\u0644\u063a \u0627\u0644\u063a\u0631\u0627\u0645\u0629\u060c \u0645\u0635\u0627\u062f\u0631\u0629 \u0627\u0644\u0648\u0633\u064a\u0644\u0629 \u0627\u0644\u062a\u064a \u0646\u0642\u0644 \u0627\u0644\u0645\u062a\u0633\u0644\u0644 \u0628\u0647\u0627\u060c \u0645\u0635\u0627\u062f\u0631\u0629 \u0645\u0633\u0643\u0646 \u0625\u064a\u0648\u0627\u0621 \u0627\u0644\u0645\u062a\u0633\u0644\u0644\u060c \u0639\u0642\u0648\u0628\u0629 \u0627\u0644\u0646\u0627\u0642\u0644 \u0623\u0648 \u0627\u0644\u0645\u0624\u0648\u064a \u0644\u0644\u0645\u062a\u0633\u0644\u0644 \u062d\u0633\u0646 \u0627\u0644\u0646\u064a\u0629\u060c \u0627\u0644\u062a\u0634\u0647\u064a\u0631\u060c \u0627\u0639\u062a\u0628\u0627\u0631 \u0647\u0630\u0647 \u0627\u0644\u062c\u0631\u0627\u0626\u0645 \u0645\u0646 \u0627\u0644\u062c\u0631\u0627\u0626\u0645 \u0627\u0644\u0643\u0628\u064a\u0631\u0629 \u0627\u0644\u0645\u0648\u062c\u0628\u0629 \u0644\u0644\u062a\u0648\u0642\u064a\u0641 \u0648\u0627\u0644\u0645\u062e\u0644\u0629 \u0628\u0627\u0644\u0634\u0631\u0641 \u0648\u0627\u0644\u0623\u0645\u0627\u0646\u0629\u060c \u062c\u0647\u0629 \u0627\u0644\u062a\u062d\u0642\u064a\u0642 \u0648\u0627\u0644\u0627\u062f\u0639\u0627\u0621\u060c \u062c\u0647\u0629 \u0627\u0644\u0646\u0638\u0631 \u0641\u064a \u0627\u0644\u062f\u0639\u0627\u0648\u0649\u060c \u0627\u0644\u0625\u0639\u0641\u0627\u0621 \u0645\u0646 \u0627\u0644\u0639\u0642\u0648\u0628\u0627\u062a\u060c \u0627\u0644\u0646\u0641\u0627\u0630\u060c \u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0623\u0646\u0638\u0645\u0629 \u0648\u0627\u0644\u062a\u0646\u0638\u064a\u0645\u0627\u062a \u0648\u0627\u0644\u0623\u0648\u0627\u0645\u0631 \u0648\u0627\u0644\u0645\u0631\u0627\u0633\u064a\u0645 \u0627\u0644\u0645\u0644\u0643\u064a\u0629 \u0648\u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u062a\u0623\u062b\u0631\u0629.", "OriginalAttachPath": "https://www.ncar.gov.sa//Uploads//c5e1e9ae-9c71-45d8-a808-2a5034e87b7e.pdf"},
{"Id": 11938, "EncriptedId": "GvR07Flkug8xGRMKm0GieQ%3D%3D", "NameAR": "\u0646\u0638\u0627\u0645 \u0645\u0647\u0646\u0629 \u0627\u0644\u0645\u062d\u0627\u0633\u0628\u0629 \u0648\u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0644\u0639\u0627\u0645 1442\u0647\u0640", "SummeryAR": "\u062d\u0644 \u0647\u0630\u0627 \u0627\u0644\u0646\u0638\u0627\u0645 \u0645\u062d\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u062d\u0627\u0633\u0628\u064a\u0646 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u064a\u0646 \u0644\u0639\u0627\u0645 1412\u0647\u0640\u060c \u0648\u062a\u0636\u0645\u0646: \u062a\u0639\u0631\u064a\u0641\u0627\u062a\u060c \u0639\u062f\u0645 \u0645\u0632\u0627\u0648\u0644\u0629 \u0627\u0644\u0645\u0647\u0646\u0629 \u0625\u0644\u0627 \u0628\u062a\u0631\u062e\u064a\u0635\u060c \u0636\u0648\u0627\u0628\u0637 \u062a\u0631\u062e\u064a\u0635 \u0627\u0644\u0645\u062a\u0641\u0631\u063a \u0648\u063a\u064a\u0631 \u0627\u0644\u0645\u062a\u0641\u0631\u063a \u0644\u0645\u0632\u0627\u0648\u0644\u0629 \u0627\u0644\u0645\u0647\u0646\u0629\u060c \u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0637\u0644\u0628 \u0627\u0644\u062a\u0631\u062e\u064a\u0635\u060c \u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062a\u0631\u062e\u064a\u0635\u060c \u0627\u0644\u0645\u0642\u0631 \u0627\u0644\u0631\u0626\u064a\u0633 \u0644\u0644\u0645\u062d\u0627\u0633\u0628 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a \u0648\u0641\u0631\u0648\u0639\u0647\u060c \u0627\u0644\u062a\u0632\u0627\u0645\u0627\u062a \u0627\u0644\u0645\u062d\u0627\u0633\u0628 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u060c \u0645\u062d\u0638\u0648\u0631\u0627\u062a \u0627\u0644\u0645\u062d\u0627\u0633\u0628 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u060c \u062a\u0648\u0642\u0641 \u0623\u0648 \u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u0645\u062d\u0627\u0633\u0628 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u060c \u0627\u0644\u0639\u0642\u0648\u0628\u0627\u062a \u0648\u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0627\u062a\u060c \u062c\u0647\u0629 \u0627\u0644\u062a\u062d\u0642\u064a\u0642\u060c \u062c\u0647\u0629 \u0627\u0644\u0646\u0638\u0631 \u0641\u064a \u062f\u0639\u0627\u0648\u064a \u0627\u0644\u062a\u0639\u0648\u064a\u0636 \u0648\u0627\u0644\u062d\u0642 \u0627\u0644\u062e\u0627\u0635\u060c \u0644\u062c\u0646\u0629 \u0627\u0644\u0646\u0638\u0631 \u0641\u064a \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0627\u062a\u060c \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0646\u0638\u0631 \u0641\u064a\u0647\u0627 \u0627\u0644\u0644\u062c\u0646\u0629\u060c \u0645\u0646\u0639 \u0627\u0644\u0645\u062d\u0627\u0633\u0628 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a \u0627\u0644\u0645\u062e\u0627\u0644\u0641 \u0627\u062d\u062a\u0631\u0627\u0632\u064a\u0627\u064b \u0645\u0646 \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0644\u0639\u0645\u0644\u0627\u0626\u0647\u060c \u0627\u0633\u062a\u062f\u0639\u0627\u0621 \u0627\u0644\u0645\u062e\u0627\u0644\u0641 \u0648\u0633\u0645\u0627\u0639 \u0623\u0642\u0648\u0627\u0644\u0647\u060c \u0637\u0644\u0628 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0631\u062e\u064a\u0635\u060c \u0636\u0628\u0637 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0627\u062a\u060c \u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0644\u0627\u0626\u062d\u0629\u060c \u0627\u0644\u0646\u0634\u0631 \u0648\u0627\u0644\u0646\u0641\u0627\u0630.", "OriginalAttachPath": "https://www.ncar.gov.sa//Uploads//9643c285-f2e9-4b36-9a1b-ce876465a72f.pdf"},
{"Id": 11926, "EncriptedId": "7%2BnQk%2BkTT35emlAWFllsOg%3D%3D", "NameAR": "\u062a\u062d\u062f\u064a\u062f \u0645\u062f\u0629 \u0627\u0644\u0625\u062c\u0627\u0632\u0629 \u0627\u0644\u0633\u0646\u0648\u064a\u0629 \u0644\u0644\u0648\u0632\u0631\u0627\u0621 \u0648\u0645\u0646 \u0647\u0645 \u0641\u064a \u0645\u0631\u062a\u0628\u0629 \u0648\u0632\u064a\u0631 \u0648\u0627\u0644\u0645\u0631\u062a\u0628\u0629 \u0627\u0644\u0645\u0645\u062a\u0627\u0632\u0629", "SummeryAR": "\u062a\u0636\u0645\u0646 \u0627\u0644\u0623\u0645\u0631 \u0627\u0644\u0633\u0627\u0645\u064a: \u062a\u0643\u0648\u0646 \u0645\u062f\u0629 \u0627\u0644\u0625\u062c\u0627\u0632\u0629 \u0627\u0644\u0633\u0646\u0648\u064a\u0629 \u0644\u0644\u0648\u0632\u0631\u0627\u0621 \u0648\u0645\u0646 \u0647\u0645 \u0641\u064a \u0645\u0631\u062a\u0628\u0629 \u0648\u0632\u064a\u0631\u060c \u0648\u0627\u0644\u0645\u0631\u062a\u0628\u0629 \u0627\u0644\u0645\u0645\u062a\u0627\u0632\u0629 (42) \u064a\u0648\u0645\u0627\u064b.", "OriginalAttachPath": "https://www.ncar.gov.sa//Uploads//8ae47f6c-7050-44be-8ff2-e460e8c50e79.pdf"},
{"Id": 11931, "EncriptedId": "zSoZOl%2FSMufoFdchK8IUAg%3D%3D", "NameAR": "\u062a\u0646\u0638\u064a\u0645 \u0647\u064a\u0626\u0629 \u0627\u0644\u062d\u0643\u0648\u0645\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u0644\u0639\u0627\u0645 1442\u0647\u0640", "SummeryAR": "\u062a\u0636\u0645\u0646 \u0627\u0644\u062a\u0646\u0638\u064a\u0645: \u062a\u0639\u0631\u064a\u0641\u0627\u062a\u060c \u0634\u062e\u0635\u064a\u0629 \u0627\u0644\u0647\u064a\u0626\u0629 \u0648\u0627\u0633\u062a\u0642\u0644\u0627\u0644\u0647\u0627 \u0648\u0627\u0631\u062a\u0628\u0627\u0637\u0647\u0627 \u0648\u0645\u0642\u0631\u0647\u0627 \u0648\u0641\u0631\u0648\u0639\u0647\u0627\u060c \u0647\u062f\u0641 \u0627\u0644\u0647\u064a\u0626\u0629\u060c \u0627\u062e\u062a\u0635\u0627\u0635\u0627\u062a \u0648\u0645\u0647\u0645\u0627\u062a \u0627\u0644\u0647\u064a\u0626\u0629\u060c \u0627\u0644\u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u0645\u062d\u0642\u0642\u0629 \u0644\u062a\u062d\u0642\u064a\u0642 \u0627\u0644\u0623\u0647\u062f\u0627\u0641\u060c \u0645\u062c\u0644\u0633 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0647\u064a\u0626\u0629\u060c \u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0648\u0627\u062e\u062a\u0635\u0627\u0635\u0627\u062a \u0627\u0644\u0645\u062c\u0644\u0633\u060c \u0627\u062c\u062a\u0645\u0627\u0639\u0627\u062a \u0627\u0644\u0645\u062c\u0644\u0633\u060c \u0645\u062d\u0627\u0641\u0638 \u0627\u0644\u0647\u064a\u0626\u0629 \u0645\u0633\u0624\u0648\u0644\u064a\u0627\u062a\u0647 \u0648\u0635\u0644\u0627\u062d\u064a\u0627\u062a\u0647\u060c \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0648\u0638\u064a\u0641\u064a \u0644\u0645\u0646\u0633\u0648\u0628\u064a \u0627\u0644\u0647\u064a\u0626\u0629\u060c \u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0627\u0644\u0647\u064a\u0626\u0629 \u0648\u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629\u060c \u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0647\u064a\u0626\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629\u060c \u0625\u064a\u0631\u0627\u062f\u0627\u062a \u0627\u0644\u0647\u064a\u0629 \u0648\u062d\u0633\u0627\u0628\u0647\u0627 \u0627\u0644\u062c\u0627\u0631\u064a\u060c \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0633\u0646\u0648\u064a\u060c \u062d\u0633\u0627\u0628 \u0627\u0644\u0647\u064a\u0626\u0629 \u0627\u0644\u062e\u062a\u0627\u0645\u064a\u060c \u0627\u0644\u0631\u0642\u0627\u0628\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629\u060c \u0627\u0644\u0625\u0639\u0641\u0627\u0621 \u0627\u0644\u062c\u0645\u0631\u0643\u064a\u060c \u0627\u0644\u0646\u0634\u0631 \u0648\u0627\u0644\u0646\u0641\u0627\u0630.", "OriginalAttachPath": "https://www.ncar.gov.sa//Uploads//f6afc796-0b14-4fc2-9814-5026c6f1098c.pdf"},
{"Id": 11932, "EncriptedId": "s6R308CI3BzlQY31Me75WA%3D%3D", "NameAR": "\u062d\u0648\u0643\u0645\u0629 \u0627\u0644\u0623\u062f\u0648\u0627\u0631 \u0628\u064a\u0646 \u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u062a\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 (\u064a\u0633\u0631) \u0648\u0645\u0631\u0643\u0632 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0648\u0637\u0646\u064a \u0628\u0627\u0644\u0647\u064a\u0626\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0644\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a", "SummeryAR": "\u062a\u0636\u0645\u0646 \u0642\u0631\u0627\u0631 \u0645\u062c\u0644\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621: \u0646\u0642\u0644 \u0642\u0646\u0627\u0629 \u0627\u0644\u062a\u0643\u0627\u0645\u0644 \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 (GSB) \u0645\u0646 \u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u062a\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 (\u064a\u0633\u0631) \u0625\u0644\u0649 \u0645\u0631\u0643\u0632 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0648\u0637\u0646\u064a\u060c \u0646\u0642\u0644 \u0627\u0644\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u0627\u0644\u0645\u0648\u062d\u062f\u0629 (GOV.SA) \u0645\u0646 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0625\u0644\u0649 \u0627\u0644\u0645\u0631\u0643\u0632\u060c \u0646\u0642\u0644 \u0627\u0644\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u0644\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0641\u062a\u0648\u062d\u0629 (DATA.GOV.SA) \u0645\u0646 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0625\u0644\u0649 \u0627\u0644\u0645\u0631\u0643\u0632\u060c \u0646\u0642\u0644 \u0627\u0644\u0634\u0642 \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a \u0644\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u0645\u0646 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0644\u062a\u0635\u062f\u064a\u0642 \u0627\u0644\u0631\u0642\u0645\u064a \u0625\u0644\u0649 \u0645\u0631\u0643\u0632 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0648\u0637\u0646\u064a\u060c \u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a\u0629 \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0644\u0644\u0634\u0628\u0643\u0629 \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 \u062e\u0644\u0627\u0644 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u0646\u0642\u0644\u060c \u0627\u0644\u0622\u0644\u064a\u0629 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0639\u0645\u064a\u0644\u0629 \u0627\u0644\u0646\u0642\u0644.", "OriginalAttachPath": "https://www.ncar.gov.sa//Uploads//011a31c1-8e62-42f2-ba6e-fb11ad312ef1.pdf"},
{"Id": 11933, "EncriptedId": "zWwdTd9x1PAppWhcAVpaYQ%3D%3D", "NameAR": "\u0625\u0644\u063a\u0627\u0621 \u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u062a\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 (\u064a\u0633\u0631) \u0648\u0625\u062d\u0644\u0627\u0644 \u0647\u064a\u0626\u0629 \u0627\u0644\u062d\u0643\u0648\u0645\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u0645\u062d\u0644 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c", "SummeryAR": "\u062a\u0636\u0645\u0646 \u0642\u0631\u0627\u0631 \u0645\u062c\u0644\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621: \u0625\u0644\u063a\u0627\u0621 \u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u062a\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 (\u064a\u0633\u0631)\u060c \u0648\u0623\u0646 \u062a\u062d\u0644 \u0647\u064a\u0626\u0629 \u0627\u0644\u062d\u0643\u0648\u0645\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u0645\u062d\u0644 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0641\u064a \u0627\u0644\u0645\u0634\u0631\u0648\u0639\u0627\u062a \u0648\u0627\u0644\u0645\u0628\u0627\u062f\u0631\u0627\u062a \u0627\u0644\u0635\u0627\u062f\u0631 \u0628\u0634\u0623\u0646\u0647\u0627 \u0642\u0631\u0627\u0631\u0627\u062a \u0645\u0646 \u0645\u062c\u0644\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621 \u0648\u0623\u0648\u0627\u0645\u0631 \u0633\u0627\u0645\u064a\u0629 \u0630\u0627\u062a \u0635\u0644\u0629.", "OriginalAttachPath": "https://www.ncar.gov.sa//Uploads//e836ccbf-0db0-4f18-86e7-7b8b21194e5b.pdf"}
